{
  "name": "easy-ja-cli",
  "version": "0.1.0",
  "description": "厚生労働省「わかりやすい情報提供に関するガイドライン」に沿って、ソースコード内の日本語をチェックする CLI",
  "keywords": [
    "japanese",
    "lint",
    "cli",
    "accessibility",
    "a11y",
    "easy-japanese",
    "わかりやすい日本語"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "easy-ja": "bin/easy-ja.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@babel/parser": "^8.0.7",
    "htmlparser2": "^12.0.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@babel/types": "^8.0.6",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
